/* ── Reset & Variables ─────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:       #050a0f;
  --bg2:      #080e16;
  --panel:    #0b1320;
  --border:   #0f2035;
  --accent:   #00f5c4;
  --accent2:  #0088ff;
  --red:      #ff2d55;
  --orange:   #ff9500;
  --yellow:   #ffd60a;
  --text:     #c8d8e8;
  --text-dim: #4a6080;
  --safe:     #00f5c4;
  --medium:   #ffd60a;
  --high:     #ff9500;
  --critical: #ff2d55;

  --font-mono: 'Share Tech Mono', monospace;
  --font-body: 'Exo 2', sans-serif;
}

html, body {
  height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 14px;
  overflow-x: hidden;
}

/* ── Animated grid background ──────────────────────────────── */
.grid-bg {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(0,245,196,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,245,196,.04) 1px, transparent 1px);
  background-size: 40px 40px;
  animation: gridShift 30s linear infinite;
}
@keyframes gridShift { to { background-position: 40px 40px; } }

.scan-line {
  position: fixed; left: 0; right: 0; height: 2px; z-index: 1;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  animation: scanDown 6s linear infinite;
  opacity: .3;
}
@keyframes scanDown { from { top: 0; } to { top: 100vh; } }

/* ── Header ─────────────────────────────────────────────────── */
header {
  position: relative; z-index: 10;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 24px;
  background: rgba(8,14,22,.95);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(10px);
}

.logo { display: flex; align-items: center; gap: 14px; }
.logo-icon svg { width: 42px; height: 42px; filter: drop-shadow(0 0 8px var(--accent)); }
.logo-name {
  display: block;
  font-family: var(--font-mono);
  font-size: 20px;
  letter-spacing: 4px;
  color: var(--accent);
  text-shadow: 0 0 20px rgba(0,245,196,.5);
}
.logo-sub { display: block; font-size: 11px; color: var(--text-dim); letter-spacing: 1px; margin-top: 2px; }

.header-right { display: flex; align-items: center; gap: 20px; }

.model-badge {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 14px;
  border: 1px solid var(--accent);
  border-radius: 20px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 2px;
  color: var(--accent);
  background: rgba(0,245,196,.06);
}
.badge-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--accent);
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:1; transform:scale(1);} 50%{opacity:.4; transform:scale(1.3);} }

.live-clock {
  font-family: var(--font-mono);
  font-size: 18px;
  color: var(--text);
  letter-spacing: 2px;
}

/* ── Stats bar ───────────────────────────────────────────────── */
.stats-bar {
  position: relative; z-index: 10;
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 1px;
  background: var(--border);
  border-bottom: 1px solid var(--border);
}
.stat-card {
  padding: 16px 24px;
  background: var(--bg2);
  text-align: center;
  transition: background .3s;
}
.stat-card:hover { background: var(--panel); }
.stat-value {
  font-family: var(--font-mono);
  font-size: 32px;
  font-weight: 900;
  color: var(--accent);
  line-height: 1;
  transition: all .3s;
}
.stat-alert .stat-value  { color: var(--orange); }
.stat-critical .stat-value { color: var(--red); }
.stat-safe .stat-value   { color: var(--safe); }
.stat-label {
  font-size: 11px; color: var(--text-dim);
  letter-spacing: 1.5px; margin-top: 4px; text-transform: uppercase;
}

/* ── Main layout ─────────────────────────────────────────────── */
main {
  position: relative; z-index: 10;
  display: grid;
  grid-template-columns: 280px 1fr 300px;
  height: calc(100vh - 130px);
  gap: 0;
}

/* ── Shared panel styles ─────────────────────────────────────── */
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 16px;
  margin-bottom: 8px;
}
.panel-title {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--accent);
  margin-bottom: 10px;
  display: flex; align-items: center; gap: 8px;
}
.panel-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin-bottom: 12px; }

/* ── Left control panel ──────────────────────────────────────── */
.control-panel {
  padding: 10px;
  overflow-y: auto;
  border-right: 1px solid var(--border);
  background: var(--bg2);
}

.sim-controls { display: flex; gap: 8px; margin-bottom: 12px; }
.btn {
  display: flex; align-items: center; gap: 6px;
  padding: 9px 14px;
  border: none; border-radius: 3px;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 1px;
  cursor: pointer; transition: all .2s;
  white-space: nowrap;
}
.btn-primary {
  background: var(--accent); color: #000; font-weight: 700;
  box-shadow: 0 0 16px rgba(0,245,196,.3);
}
.btn-primary:hover { box-shadow: 0 0 24px rgba(0,245,196,.5); transform: translateY(-1px); }
.btn-primary:disabled { background: var(--text-dim); box-shadow: none; cursor: not-allowed; }
.btn-secondary {
  background: transparent; color: var(--text-dim);
  border: 1px solid var(--border);
}
.btn-secondary:enabled { color: var(--text); border-color: var(--text-dim); }
.btn-secondary:enabled:hover { border-color: var(--accent); color: var(--accent); }
.btn-danger { background: rgba(255,45,85,.15); color: var(--red); border: 1px solid rgba(255,45,85,.3); }
.btn-danger:hover { background: rgba(255,45,85,.25); }
.full-width { width: 100%; justify-content: center; }

.sim-speed {
  display: flex; align-items: center; gap: 8px;
  font-size: 11px; color: var(--text-dim);
}
.sim-speed input[type=range] {
  flex: 1; accent-color: var(--accent);
}

/* ── Upload zone ─────────────────────────────────────────────── */
.upload-zone {
  border: 2px dashed var(--border);
  border-radius: 6px;
  padding: 20px 10px;
  text-align: center;
  cursor: pointer;
  transition: all .2s;
  margin-bottom: 10px;
}
.upload-zone:hover { border-color: var(--accent); background: rgba(0,245,196,.04); }
.upload-icon { font-size: 24px; margin-bottom: 6px; opacity: .5; }
.upload-text { font-size: 13px; color: var(--text); }
.upload-sub  { font-size: 11px; color: var(--text-dim); margin-top: 3px; }

.upload-progress { margin-top: 8px; }
.progress-bar { height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
.progress-fill {
  height: 100%; width: 0%;
  background: var(--accent);
  transition: width .3s;
  animation: progressPulse 1s ease-in-out infinite alternate;
}
@keyframes progressPulse { to { opacity: .6; } }
#progressText { font-size: 11px; color: var(--text-dim); margin-top: 4px; display: block; font-family: var(--font-mono); }
.hidden { display: none !important; }

/* ── Attack chart ─────────────────────────────────────────────── */
.attack-chart { font-family: var(--font-mono); font-size: 11px; }
.chart-row { margin-bottom: 8px; }
.chart-label { display: flex; justify-content: space-between; margin-bottom: 3px; color: var(--text-dim); }
.chart-label span:last-child { color: var(--text); }
.chart-bar-bg { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
.chart-bar { height: 100%; border-radius: 3px; transition: width .5s ease; }
.bar-critical { background: var(--red); }
.bar-high     { background: var(--orange); }
.bar-medium   { background: var(--yellow); }
.bar-safe     { background: var(--safe); }

/* ── Center event feed ───────────────────────────────────────── */
.center-panel {
  display: flex; flex-direction: column;
  overflow: hidden;
}
.feed-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  background: var(--bg2);
  flex-shrink: 0;
}
.feed-header h2 {
  font-family: var(--font-mono);
  font-size: 14px;
  letter-spacing: 2px;
  color: var(--accent);
}
.feed-filters { display: flex; gap: 6px; }
.filter-btn {
  padding: 4px 12px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: transparent;
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 1px;
  cursor: pointer;
  transition: all .2s;
}
.filter-btn:hover, .filter-btn.active {
  border-color: var(--accent); color: var(--accent);
  background: rgba(0,245,196,.06);
}

.event-table-wrap {
  flex: 1; overflow-y: auto;
}
.event-table {
  width: 100%; border-collapse: collapse;
}
.event-table thead th {
  position: sticky; top: 0;
  padding: 10px 12px;
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 1.5px;
  color: var(--text-dim);
  text-align: left;
  white-space: nowrap;
}
.event-table tbody tr {
  border-bottom: 1px solid rgba(15,32,53,.8);
  cursor: pointer;
  transition: background .15s;
  animation: rowIn .3s ease;
}
@keyframes rowIn { from { opacity:0; transform:translateX(-10px); } to { opacity:1; transform:translateX(0); } }
.event-table tbody tr:hover { background: rgba(0,245,196,.04); }
.event-table tbody tr.selected { background: rgba(0,245,196,.08); }
.event-table td {
  padding: 9px 12px;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text);
  white-space: nowrap;
}
.event-table td:first-child { color: var(--text-dim); }

.verdict-chip {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 3px;
  font-size: 10px;
  letter-spacing: 1px;
  font-weight: 700;
}
.chip-safe     { background: rgba(0,245,196,.15); color: var(--safe); }
.chip-medium   { background: rgba(255,214,10,.15); color: var(--yellow); }
.chip-high     { background: rgba(255,149,0,.15);  color: var(--orange); }
.chip-critical { background: rgba(255,45,85,.15);  color: var(--red);
                 animation: critFlash 1.5s ease-in-out infinite; }
@keyframes critFlash { 0%,100%{opacity:1;} 50%{opacity:.6;} }

.sev-dot {
  display: inline-block; width: 8px; height: 8px;
  border-radius: 50%; margin-right: 6px;
}
.sev-safe     { background: var(--safe); }
.sev-medium   { background: var(--yellow); }
.sev-high     { background: var(--orange); }
.sev-critical { background: var(--red);
                box-shadow: 0 0 6px var(--red);
                animation: pulse 1s ease-in-out infinite; }

.prob-bar {
  display: inline-flex; align-items: center; gap: 4px; width: 80px;
}
.prob-num { font-size: 10px; min-width: 35px; }
.prob-track { flex:1; height: 3px; background: var(--border); border-radius: 2px; }
.prob-fill  { height: 100%; border-radius: 2px; transition: width .3s; }

/* ── Empty state ─────────────────────────────────────────────── */
.empty-row td { text-align: center; padding: 60px 20px !important; }
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.empty-state p { color: var(--text-dim); font-family: var(--font-mono); }
.empty-sub { font-size: 11px; opacity: .6; }
.pulse-ring {
  width: 40px; height: 40px; border-radius: 50%;
  border: 2px solid var(--accent);
  animation: ringPulse 2s ease-out infinite;
  opacity: .5;
}
@keyframes ringPulse { to { transform: scale(2); opacity: 0; } }

/* ── Right detail panel ──────────────────────────────────────── */
.detail-panel {
  padding: 10px;
  overflow-y: auto;
  border-left: 1px solid var(--border);
  background: var(--bg2);
}
.event-detail-empty, .mitre-empty {
  font-size: 12px; color: var(--text-dim);
  font-family: var(--font-mono);
  text-align: center; padding: 16px 0;
}

.detail-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
}
.detail-item label {
  display: block; font-size: 10px; color: var(--text-dim);
  letter-spacing: 1px; margin-bottom: 2px;
}
.detail-item span {
  font-family: var(--font-mono); font-size: 12px; color: var(--text);
}
.detail-verdict {
  grid-column: 1/-1; padding: 10px; border-radius: 4px; margin-top: 4px;
  font-family: var(--font-mono); font-size: 13px; text-align: center;
  font-weight: 700; letter-spacing: 2px;
}

.mitre-card {
  background: rgba(0,136,255,.06);
  border: 1px solid rgba(0,136,255,.2);
  border-radius: 4px;
  padding: 12px;
}
.mitre-id {
  font-family: var(--font-mono); font-size: 11px;
  color: var(--accent2); letter-spacing: 2px; margin-bottom: 4px;
}
.mitre-name { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
.mitre-tactic {
  display: inline-block; padding: 3px 10px;
  border: 1px solid rgba(0,136,255,.3);
  border-radius: 20px;
  font-size: 10px; color: var(--accent2);
  font-family: var(--font-mono); letter-spacing: 1px;
}

/* ── Pipeline ─────────────────────────────────────────────────── */
.pipeline { display: flex; flex-direction: column; gap: 4px; }
.pipe-step {
  display: flex; align-items: center; gap: 10px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--bg);
  transition: all .3s;
}
.pipe-step.active { border-color: var(--accent); background: rgba(0,245,196,.06); }
.pipe-step.done   { border-color: rgba(0,245,196,.3); }
.pipe-num {
  width: 26px; height: 26px; border-radius: 50%;
  background: var(--border);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 12px;
  flex-shrink: 0;
}
.pipe-step.active .pipe-num { background: var(--accent); color: #000; }
.pipe-name { font-size: 12px; font-weight: 600; }
.pipe-sub  { font-size: 10px; color: var(--text-dim); }
.pipe-status { margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); }
.pipe-arrow { text-align: center; color: var(--text-dim); font-size: 10px; }

/* ── Toast ───────────────────────────────────────────────────── */
#toastContainer {
  position: fixed; bottom: 20px; right: 20px; z-index: 999;
  display: flex; flex-direction: column; gap: 8px; pointer-events: none;
}
.toast {
  padding: 10px 18px;
  border-radius: 4px;
  font-family: var(--font-mono); font-size: 12px;
  background: var(--panel);
  border-left: 3px solid var(--accent);
  box-shadow: 0 4px 20px rgba(0,0,0,.5);
  animation: toastIn .3s ease, toastOut .3s ease 3s forwards;
  pointer-events: auto;
}
.toast-critical { border-color: var(--red); color: var(--red); }
.toast-high     { border-color: var(--orange); color: var(--orange); }
@keyframes toastIn  { from { opacity:0; transform:translateX(20px); } }
@keyframes toastOut { to   { opacity:0; transform:translateX(20px); } }

/* ── Scrollbar ───────────────────────────────────────────────── */
::-webkit-scrollbar { width: 4px; height: 4px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
::-webkit-scrollbar-thumb:hover { background: var(--accent); }
